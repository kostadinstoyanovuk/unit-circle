ilure handling and reporting. Registration and the required validation precede acquisition of the UK observations. The study does not claim causal tipping, real-time forecasting or established novelty.","license":"https://creativecommons.org/licenses/by/4.0/legalcode","osf_project":"https://api.osf.io/v2/nodes/92sjv/?version=2.20","osf_registration_doi":"10.17605/OSF.IO/WCNBZ","osf_registration_schema":"Secondary Data Preregistration","osf_registry":"OSF Registries","osf_subjects":["Social and Behavioral Sciences","Economics","Physical Sciences and Mathematics","Statistics and Probability"],"osf_tags":["autoregression","persistence","preregistration","recession","surrogate testing","UK GDP","unit circle"],"publisher":"Center for Open Science","scanner":"Internet Archive Python library 1.9.9","source":"https://osf.io/wcnbz/","title":"Did UK recessions give warning? A preregistered AR(2) persistence study","uploader":"ops-admin@cos.io","mediatype":"data","collection_added":["osf-registrations","osf"],"publicdate":"2026-09-27 04:50:09","addeddate":"2026-09-27 04:50:09"},"server":"ia803200.us.archive.org","uniq":1693235018,"workable_servers":["ia803200.us.archive.org","ia903200.us.archive.org"]}